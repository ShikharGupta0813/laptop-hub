{
  "name": "Laptop Hub",
  "short_name": "Hub",
  "description": "Your laptop's files, notes, terminal and assistant, from your phone.",
  "id": "/",
  "start_url": "/#/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0b0f",
  "theme_color": "#0a0b0f",
  "categories": ["productivity", "utilities"],
  "icons": [
    {"src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"},
    {"src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any"}
  ],
  "shortcuts": [
    {"name": "Talk", "url": "/#/assistant", "icons": [{"src": "/icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "New note", "url": "/#/notes/new", "icons": [{"src": "/icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "Work", "url": "/#/work", "icons": [{"src": "/icons/icon-192.png", "sizes": "192x192"}]}
  ]
}
